        "import os\n",
        "import json\n",
        "from datetime import datetime\n",
        "\n",
        "# =====================================================================\n",
        "# CONFIGURATION - Enter your Notion & Search Settings\n",
        "# =====================================================================\n",
        "\n",
        "# 1. Notion API Credentials (get token from https://www.notion.so/my-integrations)\n",
        "NOTION_API_KEY = os.getenv(\"NOTION_API_KEY\", \"secret_YOUR_NOTION_INTEGRATION_KEY\")\n",
        "\n",
        "# 2. Notion Database ID (from database URL: notion.so/<workspace>/<DATABASE_ID>?v=...)\n",
        "NOTION_DATABASE_ID = os.getenv(\"NOTION_DATABASE_ID\", \"YOUR_32_CHAR_DATABASE_ID\")\n",
        "\n",
        "# 3. Optional: RapidAPI JSearch Key for live multi-board aggregation (LinkedIn, Glassdoor, Gupy)\n",
        "# If left empty, the engine uses live RSS/Adzuna feeds and Brazilian tech job providers\n",
        "RAPIDAPI_KEY = os.getenv(\"RAPIDAPI_KEY\", \"\")\n",
        "\n",
        "# 4. Search Parameters for São Paulo Data Analytics\n",
        "SEARCH_QUERY = '\"Data Analytics\" OR \"Analista de Dados\" OR \"Analytics Engineer\"'\n",
        "SEARCH_LOCATION = \"São Paulo, Brazil\"\n",
        "LOCAL_STORAGE_FILE = \"jobs_tracker_data.json\"\n",
        "\n",
        "print(f\"🎯 Target Location: {SEARCH_LOCATION}\")\n",
        "print(f\"🔍 Search Query: {SEARCH_QUERY}\")\n",
        "print(f\"📁 Local Storage: {LOCAL_STORAGE_FILE}\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {},
      "outputs": [],
      "source": [
        "import requests\n",
        "\n",
        "class NotionSyncClient:\n",
        "    \"\"\"Client for interacting with the official Notion REST API.\"\"\"\n",
        "    \n",
        "    BASE_URL = \"https://api.notion.com/v1\"\n",
        "    NOTION_VERSION = \"2022-06-28\"\n",
        "\n",
        "    def __init__(self, api_key: str, database_id: str):\n",
        "        self.api_key = api_key.strip()\n",
        "        self.database_id = database_id.strip().replace(\"-\", \"\")\n",
        "        self.headers = {\n",
        "            \"Authorization\": f\"Bearer {self.api_key}\",\n",
        "            \"Notion-Version\": self.NOTION_VERSION,\n",
        "            \"Content-Type\": \"application/json\",\n",
        "        }\n",
        "\n",
        "    def test_connection(self) -> dict:\n",
        "        \"\"\"Verifies if the integration can read the target Notion Database.\"\"\"\n",
        "        if not self.api_key or \"YOUR_NOTION\" in self.api_key:\n",
        "            return {\"success\": False, \"message\": \"Please set a valid NOTION_API_KEY in Cell 3\"}\n",
        "        \n",
        "        url = f\"{self.BASE_URL}/databases/{self.database_id}\"\n",
        "        try:\n",
        "            res = requests.get(url, headers=self.headers, timeout=10)\n",
        "            if res.status_code == 200:\n",
        "                data = res.json()\n",
        "                title = \"\".join([t.get(\"plain_text\", \"\") for t in data.get(\"title\", [])])\n",
        "                return {\"success\": True, \"message\": f\"Connected to Notion DB: '{title}'\"}\n",
        "            elif res.status_code == 404:\n",
        "                return {\"success\": False, \"message\": \"Database not found. Did you share it with your Integration in Notion?\"}\n",
        "            else:\n",
        "                return {\"success\": False, \"message\": f\"Error {res.status_code}: {res.text}\"}\n",
        "        except Exception as e:\n",
        "            return {\"success\": False, \"message\": f\"Connection failed: {str(e)}"}\n",
        "\n",
        "    def create_application_page(self, job: dict, notes: str = \"\", salary: str = \"\") -> dict:\n",
        "        \"\"\"Creates a new record row in the Notion Job Application Tracker database.\"\"\"\n",
        "        url = f\"{self.BASE_URL}/pages\"\n",
        "        today_str = datetime.now().strftime(\"%Y-%m-%d\")\n",
        "\n",
        "        payload = {\n",
        "            \"parent\": {\"database_id\": self.database_id},\n",
        "            \"properties\": {\n",
        "                \"Job Title\": {\n",
        "                    \"title\": [{\"text\": {\"content\": job.get(\"title\", \"Data Analyst\")[:100]}}]\n",
        "                },\n",
        "                \"Company\": {\n",
        "                    \"rich_text\": [{\"text\": {\"content\": job.get(\"company\", \"Empresa\")[:100]}}]\n",
        "                },\n",
        "                \"Status\": {\n",
        "                    \"select\": {\"name\": \"Applied\"}\n",
        "                },\n",
        "                \"Date Applied\": {\n",
        "                    \"date\": {\"start\": today_str}\n",
        "                },\n",
        "                \"Location\": {\n",
        "                    \"rich_text\": [{\"text\": {\"content\": job.get(\"location\", \"São Paulo, SP\")[:100]}}]\n",
        "                },\n",
        "                \"Job URL\": {\n",
        "                    \"url\": job.get(\"apply_url\") or job.get(\"url\") or \"https://linkedin.com\"\n",
        "                },\n",
        "                \"Salary\": {\n",
        "                    \"rich_text\": [{\"text\": {\"content\": salary or job.get(\"salary\", \"A combinar\")[:80]}}]\n",
        "                },\n",
        "                \"Notes\": {\n",
        "                    \"rich_text\": [{\"text\": {\"content\": notes or job.get(\"notes\", \"Auto-logged by Python Agent\")[:2000]}}]\n",
        "                }\n",
        "            }\n",
        "        }\n",
        "\n",
        "        try:\n",
        "            res = requests.post(url, headers=self.headers, json=payload, timeout=15)\n",
        "            if res.status_code == 200:\n",
        "                page_data = res.json()\n",
        "                return {\"success\": True, \"page_id\": page_data.get(\"id\"), \"url\": page_data.get(\"url\")}\n",
        "            else:\n",
        "                return {\"success\": False, \"error\": f\"{res.status_code}: {res.text}\"}\n",
        "        except Exception as e:\n",
        "            return {\"success\": False, \"error\": str(e)}\n",
        "\n",
        "notion_client = NotionSyncClient(NOTION_API_KEY, NOTION_DATABASE_ID)\n",
        "print(\"NotionSyncClient ready!\")\n"
      ]
    },
