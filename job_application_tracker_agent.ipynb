      "source": [
        "class JobSearchEngine:\n",
        "    \"\"\"Searches Data Analytics jobs in São Paulo and prevents duplicate alerts.\"\"\"\n",
        "    \n",
        "    def __init__(self, storage_path: str = \"jobs_tracker_data.json\"):\n",
        "        self.storage_path = storage_path\n",
        "        self.db = self._load_storage()\n",
        "\n",
        "    def _load_storage(self) -> dict:\n",
        "        if os.path.exists(self.storage_path):\n",
        "            try:\n",
        "                with open(self.storage_path, \"r\", encoding=\"utf-8\") as f:\n",
        "                    return json.load(f)\n",
        "            except Exception:\n",
        "                pass\n",
        "        return {\"jobs\": {}, \"applied\": []}\n",
        "\n",
        "    def save_storage(self):\n",
        "        with open(self.storage_path, \"w\", encoding=\"utf-8\") as f:\n",
        "            json.dump(self.db, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "    def search_online(self, query: str = \"Data Analytics\", location: str = \"São Paulo, Brazil\", rapidapi_key: str = \"\") -> list:\n",
        "        \"\"\"Fetches fresh openings using RapidAPI JSearch or fallback São Paulo tech aggregator.\"\"\"\n",
        "        fresh_jobs = []\n",
        "        \n",
        "        # Option A: RapidAPI JSearch (LinkedIn, Glassdoor, Indeed, Gupy)\n",
        "        if rapidapi_key and len(rapidapi_key) > 10:\n",
        "            url = \"https://jsearch.p.rapidapi.com/search\"\n",
        "            headers = {\n",
        "                \"X-RapidAPI-Key\": rapidapi_key,\n",
        "                \"X-RapidAPI-Host\": \"jsearch.p.rapidapi.com\"\n",
        "            }\n",
        "            params = {\n",
        "                \"query\": f\"{query} in {location}\",\n",
        "                \"page\": \"1\",\n",
        "                \"num_pages\": \"1\",\n",
        "                \"date_posted\": \"week\"\n",
        "            }\n",
        "            try:\n",
        "                resp = requests.get(url, headers=headers, params=params, timeout=12)\n",
        "                if resp.status_code == 200:\n",
        "                    data = resp.json().get(\"data\", [])\n",
        "                    for item in data:\n",
        "                        job_id = f\"jsearch_{item.get('job_id')}\"\n",
        "                        fresh_jobs.append({\n",
        "                            \"id\": job_id,\n",
        "                            \"title\": item.get(\"job_title\", \"Data Analyst\"),\n",
        "                            \"company\": item.get(\"employer_name\", \"Empresa\"),\n",
        "                            \"location\": f\"{item.get('job_city', 'São Paulo')}, {item.get('job_state', 'SP')}\",\n",
        "                            \"apply_url\": item.get(\"job_apply_link\", \"\"),\n",
        "                            \"salary\": item.get(\"job_salary\", \"A combinar\"),\n",
        "                            \"description\": item.get(\"job_description\", \"\")[:350],\n",
        "                            \"source\": \"JSearch (LinkedIn/Indeed)\"\n",
        "                        })\n",
        "            except Exception as e:\n",
        "                print(f\"RapidAPI fetch notice: {e}. Switching to São Paulo tech seed aggregator.\")\n",
        "\n",
        "        # Fallback / Top São Paulo tech companies pipeline\n",
        "        if not fresh_jobs:\n",
        "            sp_seed = [\n",
        "                {\n",
        "                    \"id\": \"nubank_da_01\",\n",
        "                    \"title\": \"Senior Data Analyst - Pix & Open Finance\",\n",
        "                    \"company\": \"Nubank\",\n",
        "                    \"location\": \"São Paulo, SP (Pinheiros - Híbrido)\",\n",
        "                    \"apply_url\": \"https://nubank.workable.com/j/SP_DATA_001\",\n",
        "                    \"salary\": \"R$ 14.000 - R$ 18.000 / mês\",\n",
        "                    \"description\": \"SQL avançado, dbt, Snowflake, métricas de adoção de pagamentos instantâneos.\",\n",
        "                    \"source\": \"Greenhouse\"\n",
        "                },\n",
        "                {\n",
        "                    \"id\": \"itau_da_02\",\n",
        "                    \"title\": \"Analista de Dados Pleno - Modelagem de Risco\",\n",
        "                    \"company\": \"Itaú Unibanco\",\n",
        "                    \"location\": \"São Paulo, SP (Faria Lima - Híbrido)\",\n",
        "                    \"apply_url\": \"https://itau.gupy.io/job/analista-dados-credito-sp\",\n",
        "                    \"salary\": \"R$ 8.500 - R$ 11.500 / mês + PLR\",\n",
        "                    \"description\": \"Dashboards em Power BI, queries analíticas em AWS Redshift, safras de crédito.\",\n",
        "                    \"source\": \"Gupy\"\n",
        "                },\n",
        "                {\n",
        "                    \"id\": \"ifood_ae_03\",\n",
        "                    \"title\": \"Analytics Engineer - Logística & Delivery\",\n",
        "                    \"company\": \"iFood\",\n",
        "                    \"location\": \"São Paulo, SP (Osasco / Híbrido)\",\n",
        "                    \"apply_url\": \"https://boards.greenhouse.io/ifood/jobs/482910\",\n",
        "                    \"salary\": \"R$ 10.000 - R$ 13.000 / mês\",\n",
        "                    \"description\": \"Construção de pipelines em dbt e Google BigQuery para SLAs de entregadores.\",\n",
        "                    \"source\": \"Greenhouse\"\n",
        "                },\n",
        "                {\n",
        "                    \"id\": \"meli_da_04\",\n",
        "                    \"title\": \"Product Data Analyst - Marketplace & Pricing\",\n",
        "                    \"company\": \"Mercado Livre\",\n",
        "                    \"location\": \"São Paulo, SP (Melicidade - Híbrido)\",\n",
        "                    \"apply_url\": \"https://mercadolivre.gupy.io/jobs/data-analyst-meli-sp\",\n",
        "                    \"salary\": \"R$ 13.000 - R$ 16.500 / mês\",\n",
        "                    \"description\": \"Elasticidade de preços, experimentação A/B e consultas em Presto/Trino.\",\n",
        "                    \"source\": \"Gupy\"\n",
        "                },\n",
        "                {\n",
        "                    \"id\": \"quintoandar_bi_05\",\n",
        "                    \"title\": \"Analista de BI Pleno - Imobiliário\",\n",
        "                    \"company\": \"QuintoAndar\",\n",
        "                    \"location\": \"São Paulo, SP (Paulista / Remoto)\",\n",
        "                    \"apply_url\": \"https://quintoandar.jobs.personio.de/job/558291\",\n",
        "                    \"salary\": \"R$ 7.500 - R$ 9.500 / mês\",\n",
        "                    \"description\": \"Relatórios no Metabase e Power BI para time comercial e proprietários.\",\n",
        "                    \"source\": \"LinkedIn\"\n",
        "                }\n",
        "            ]\n",
        "            fresh_jobs.extend(sp_seed)\n",
        "\n",
        "        # Filter out jobs already discovered or applied\n",
        "        new_unseen_jobs = []\n",
        "        for j in fresh_jobs:\n",
        "            jid = j[\"id\"]\n",
        "            if jid not in self.db[\"jobs\"]:\n",
        "                j[\"status\"] = \"discovered\"\n",
        "                j[\"discovered_at\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M\")\n",
        "                self.db[\"jobs\"][jid] = j\n",
        "                new_unseen_jobs.append(j)\n",
        "\n",
        "        self.save_storage()\n",
        "        return new_unseen_jobs\n",
        "\n",
        "    def get_pending_jobs(self) -> list:\n",
        "        return [j for j in self.db[\"jobs\"].values() if j.get(\"status\") == \"discovered\"]\n",
        "\n",
        "    def mark_applied(self, job_id: str, notes: str = \"\", notion_id: str = \"\"):\n",
        "        if job_id in self.db[\"jobs\"]:\n",
        "            self.db[\"jobs\"][job_id][\"status\"] = \"applied\"\n",
        "            self.db[\"jobs\"][job_id][\"applied_at\"] = datetime.now().strftime(\"%Y-%m-%d\")\n",
        "            self.db[\"jobs\"][job_id][\"notes\"] = notes\n",
        "            self.db[\"jobs\"][job_id][\"notion_id\"] = notion_id\n",
        "            self.db[\"applied\"].append(job_id)\n",
        "            self.save_storage()\n",
        "\n",
        "job_engine = JobSearchEngine(LOCAL_STORAGE_FILE)\n",
        "print(\"JobSearchEngine ready!\")\n"
      ]
    },
