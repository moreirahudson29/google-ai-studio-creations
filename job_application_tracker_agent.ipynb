        "# Test your connection to Notion\n",
        "result = notion_client.test_connection()\n",
        "if result[\"success\"]:\n",
        "    print(f\"🎉 SUCCESS: {result['message']}\")\n",
        "else:\n",
        "    print(f\"⚠️ NOTICE: {result['message']}\")\n",
        "    print(\"ℹ️ If you do not have Notion credentials ready right now, the agent can still run and buffer jobs locally!\")\n"
      ]
