        "import pandas as pd\n",
        "\n",
        "print(f\"🚀 Running daily online scan for {SEARCH_QUERY} in {SEARCH_LOCATION}...\")\n",
        "new_jobs = job_engine.search_online(SEARCH_QUERY, SEARCH_LOCATION, RAPIDAPI_KEY)\n",
        "\n",
        "pending = job_engine.get_pending_jobs()\n",
        "print(f\"✨ New positions found today: {len(new_jobs)}\")\n",
        "print(f\"📌 Total unapplied positions waiting for your review: {len(pending)}\\n\")\n",
        "\n",
        "if pending:\n",
        "    df_preview = pd.DataFrame([\n",
        "        {\n",
        "            \"ID\": j[\"id\"],\n",
        "            \"Cargo\": j[\"title\"],\n",
        "            \"Empresa\": j[\"company\"],\n",
        "            \"Local\": j[\"location\"],\n",
        "            \"Salário\": j.get(\"salary\", \"A combinar\"),\n",
        "            \"Link\": j.get(\"apply_url\")\n",
        "        } for j in pending\n",
        "    ])\n",
        "    display(df_preview)\n",
        "else:\n",
        "    print(\"You are all caught up! No new unapplied jobs pending.\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {},
      "outputs": [],
      "source": [
        "import ipywidgets as widgets\n",
        "from IPython.display import display, HTML, clear_output\n",
        "\n",
        "pending_jobs = job_engine.get_pending_jobs()\n",
        "\n",
        "if not pending_jobs:\n",
        "    print(\"No pending jobs to review right now! Run Cell 6 to find new roles.\")\n",
        "else:\n",
        "    job_options = [(f\"{j['company']} — {j['title']}\", j['id']) for j in pending_jobs]\n",
        "    \n",
        "    dropdown = widgets.Dropdown(\n",
        "        options=job_options,\n",
        "        description=\"Selecione:\",\n",
        "        layout=widgets.Layout(width=\"70%\")\n",
        "    )\n",
        "    \n",
        "    notes_input = widgets.Textarea(\n",
        "        placeholder=\"Adicione notas (ex: Indicação de Fulano, CV versão Fintech, expectativa salarial)\",\n",
        "        description=\"Notas:\",\n",
        "        layout=widgets.Layout(width=\"70%\", height=\"70px\")\n",
        "    )\n",
        "    \n",
        "    btn_apply = widgets.Button(\n",
        "        description=\"🚀 Marcar como Aplicado & Enviar para Notion\",\n",
        "        button_style=\"success\",\n",
        "        layout=widgets.Layout(width=\"50%\", height=\"42px\")\n",
        "    )\n",
        "    \n",
        "    output_area = widgets.Output()\n",
        "    \n",
        "    def on_apply_clicked(b):\n",
        "        with output_area:\n",
        "            clear_output()\n",
        "            selected_id = dropdown.value\n",
        "            notes = notes_input.value\n",
        "            job = job_engine.db[\"jobs\"].get(selected_id)\n",
        "            \n",
        "            if not job:\n",
        "                print(\"Vaga não encontrada.\")\n",
        "                return\n",
        "                \n",
        "            print(f\"⏳ Registrando candidatura para {job['company']} ({job['title']})...\")\n",
        "            \n",
        "            # Sync to Notion\n",
        "            sync_res = notion_client.create_application_page(job, notes=notes)\n",
        "            notion_id = sync_res.get(\"page_id\", \"\")\n",
        "            \n",
        "            # Update local storage\n",
        "            job_engine.mark_applied(selected_id, notes=notes, notion_id=notion_id)\n",
        "            \n",
        "            if sync_res.get(\"success\"):\n",
        "                print(f\"✅ SUCESSO! Inserido no seu Notion 'Job Application Tracker'!\")\n",
        "                if sync_res.get(\"url\"):\n",
        "                    print(f\"🔗 Abrir página no Notion: {sync_res['url']}\")\n",
        "            else:\n",
        "                print(f\"ℹ️ Salvo localmente como Aplicado. Detalhe Notion: {sync_res.get('error')}\")\n",
        "            \n",
        "            # Refresh dropdown\n",
        "            updated_pending = job_engine.get_pending_jobs()\n",
        "            dropdown.options = [(f\"{j['company']} — {j['title']}\", j['id']) for j in updated_pending]\n",
        "    \n",
        "    btn_apply.on_click(on_apply_clicked)\n",
        "    \n",
        "    print(\"👇 Selecione a vaga que você aplicou e clique para sincronizar com seu Notion:\")\n",
        "    display(widgets.VBox([dropdown, notes_input, btn_apply, output_area]))\n"
      ]
    },
