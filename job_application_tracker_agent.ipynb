        "# Summary of all applied roles\n",
        "applied_ids = job_engine.db.get(\"applied\", [])\n",
        "applied_jobs = [job_engine.db[\"jobs\"][jid] for jid in applied_ids if jid in job_engine.db[\"jobs\"]]\n",
        "\n",
        "print(f\"📊 Total de candidaturas registradas: {len(applied_jobs)}\\n\")\n",
        "if applied_jobs:\n",
        "    df_applied = pd.DataFrame([\n",
        "        {\n",
        "            \"Data de Aplicação\": j.get(\"applied_at\", \"-\"),\n",
        "            \"Empresa\": j.get(\"company\"),\n",
        "            \"Cargo\": j.get(\"title\"),\n",
        "            \"Local\": j.get(\"location\"),\n",
        "            \"Status\": \"Applied (Notion Sync)\",\n",
        "            \"Notas\": j.get(\"notes\", \"-\")\n",
        "        } for j in applied_jobs\n",
        "    ])\n",
        "    display(df_applied)\n",
        "else:\n",
        "    print(\"Nenhuma vaga marcada como aplicada ainda.\")\n"
      ]
    },
